<?xml version="1.0" encoding="utf-8"?>
<!--
  The Calendar widget's glass panel. Widgets can't blur what's behind them, so this is clear
  glass: graphite at 78% (the wallpaper shows through, white text keeps ~6:1 even over white),
  a 1dp light edge, and a faint shine across the top.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C71F2123" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
